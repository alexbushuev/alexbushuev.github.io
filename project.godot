config_version=5

[application]
config/name="Газ и цепь"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
D="*res://src/data.gd"
S="*res://src/save.gd"
N="*res://src/net.gd"

[display]
window/size/viewport_width=844
window/size/viewport_height=390
window/size/window_width_override=1280
window/size/window_height_override=590
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/dpi/allow_hidpi=true

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.09, 1)
lights_and_shadows/directional_shadow/size=1024

[audio]
general/default_playback_type.web=1
